# FlowGuard Environment Configuration
# Copy this file to .env and change credentials before deploying!

POSTGRES_DB=flowguard
POSTGRES_USER=flowguard
POSTGRES_PASSWORD=flowguard_dev_secret
POSTGRES_PORT=5432
SPRING_PROFILES_ACTIVE=dev
WORKER_ID=flowguard-worker-1
FLOWGUARD_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
